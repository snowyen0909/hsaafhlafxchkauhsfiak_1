<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <AssemblyName>Lawn</AssemblyName>
    <RootNamespace>Lawn_iOS</RootNamespace>
    <ApplicationId>net.pvz.pgvz.ios</ApplicationId>
    <ApplicationTitle>植物娘大战僵尸</ApplicationTitle>
    <ApplicationDisplayVersion>1.3.4</ApplicationDisplayVersion>
    <ApplicationVersion>10304</ApplicationVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- AOT everything, but keep the interpreter available for `dynamic` / expression trees. -->
    <MtouchInterpreter>-all</MtouchInterpreter>
    <!-- Decompiled code uses reflection; only trim the SDK. -->
    <MtouchLink>SdkOnly</MtouchLink>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- Unsigned build: signing happens on the user side (Sideloadly / AltStore / SideStore). -->
    <EnableCodeSigning>false</EnableCodeSigning>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0618;CS8632;CS0108;CS0114;CS0675;CS1717;CS0252;CS0253;CS0659;CS0661;CS0660;CA1416;CS0067;CA1422</NoWarn>
  </PropertyGroup>
  <!-- Comic edition: dotnet build -p:Comic=true  (needs ContentComic/images/600x1000/cartoon_*.xnb) -->
  <PropertyGroup Condition="'$(Comic)' == 'true'">
    <DefineConstants>$(DefineConstants);COMIC</DefineConstants>
    <ApplicationId>net.pvz.pgvz.ios.comic</ApplicationId>
    <ApplicationTitle>植物娘大战僵尸(漫画)</ApplicationTitle>
  </PropertyGroup>
  <!-- Wardrobe mod edition: dotnet build -p:Mod=true  (built-in 时装柜, title logo with badge, no iOS-port plants) -->
  <PropertyGroup Condition="'$(Mod)' == 'true'">
    <DefineConstants>$(DefineConstants);MOD</DefineConstants>
    <ApplicationId>net.pvz.pgvz.ios.wardrobe</ApplicationId>
    <ApplicationTitle>植物娘时装柜Mod版</ApplicationTitle>
    <ApplicationDisplayVersion>1.4.3</ApplicationDisplayVersion>
    <ApplicationVersion>10403</ApplicationVersion>
  </PropertyGroup>
  <Import Project="../Lawn.Common.props" />
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.4.1" />
  </ItemGroup>
  <ItemGroup Condition="Exists('native/libopenmpt.a')">
    <!-- Built by tools/build_libopenmpt_ios.sh in CI; enables the original MO3 interactive music. -->
    <NativeReference Include="native/libopenmpt.a" Kind="Static" ForceLoad="true" IsCxx="true" SmartLink="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Game assets go into the app bundle under Content/ -->
    <BundleResource Condition="'$(Mod)' != 'true'" Include="$(MSBuildThisFileDirectory)../../Content/**/*" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" />
    <BundleResource Condition="'$(Mod)' == 'true'" Include="$(MSBuildThisFileDirectory)../../Content/**/*" Exclude="$(MSBuildThisFileDirectory)../../Content/images/600x1000/*/pvz_logo.xnb;$(MSBuildThisFileDirectory)../../Content/iris/**" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Mod)' == 'true'">
    <!-- Mod edition = upstream 1.4.3: ContentMod143 holds the 1.4.3 assets that changed or are new; they
         replace their Content/ counterparts (music stays the iOS m4a set). -->
    <Mod143Asset Include="$(MSBuildThisFileDirectory)../../ContentMod143/**/*" />
    <BundleResource Remove="@(Mod143Asset->'$(MSBuildThisFileDirectory)../../Content/%(RecursiveDir)%(Filename)%(Extension)')" />
    <BundleResource Include="@(Mod143Asset)" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" />
    <BundleResource Include="$(MSBuildThisFileDirectory)../../ContentMod/**/*" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Comic)' == 'true'">
    <BundleResource Include="$(MSBuildThisFileDirectory)../../ContentComic/**/*" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
