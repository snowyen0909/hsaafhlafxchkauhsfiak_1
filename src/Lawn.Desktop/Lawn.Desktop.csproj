<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop (Linux/Windows) debug runner: reproduces startup issues without an iPhone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>LawnDesktop</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0618;CS8632;CS0108;CS0114;CS0675;CS1717;CS0252;CS0253;CS0659;CS0661;CS0660;CA1416;CS0067</NoWarn>
  </PropertyGroup>
  <Import Project="../Lawn.Common.props" />
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>
</Project>
